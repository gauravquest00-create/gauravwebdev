'use client';

import React, { useEffect, useRef } from 'react';
import { useTheme } from '@/context/ThemeContext';

interface Vec3 {
  x: number;
  y: number;
  z: number;
}

function createIcosahedron(radius: number): { vertices: Vec3[]; edges: [number, number][] } {
  const phi = (1 + Math.sqrt(5)) / 2;
  const raw: [number, number, number][] = [
    [-1, phi, 0],
    [1, phi, 0],
    [-1, -phi, 0],
    [1, -phi, 0],
    [0, -1, phi],
    [0, 1, phi],
    [0, -1, -phi],
    [0, 1, -phi],
    [phi, 0, -1],
    [phi, 0, 1],
    [-phi, 0, -1],
    [-phi, 0, 1],
  ];

  const vertices: Vec3[] = raw.map(([x, y, z]) => {
    const len = Math.hypot(x, y, z);
    return {
      x: (x / len) * radius,
      y: (y / len) * radius,
      z: (z / len) * radius,
    };
  });

  const edges: [number, number][] = [];
  const edgeThreshold = (2 / Math.hypot(1, phi)) * radius * 1.05;

  for (let i = 0; i < vertices.length; i++) {
    for (let j = i + 1; j < vertices.length; j++) {
      const dist = Math.hypot(
        vertices[i].x - vertices[j].x,
        vertices[i].y - vertices[j].y,
        vertices[i].z - vertices[j].z
      );
      if (dist <= edgeThreshold) {
        edges.push([i, j]);
      }
    }
  }

  return { vertices, edges };
}

function createTorusRing(radius: number, segments: number): Vec3[] {
  const pts: Vec3[] = [];
  for (let i = 0; i < segments; i++) {
    const theta = (i / segments) * Math.PI * 2;
    pts.push({
      x: Math.cos(theta) * radius,
      y: Math.sin(theta) * radius,
      z: 0,
    });
  }
  return pts;
}

function rotatePoint(p: Vec3, rx: number, ry: number, rz: number): Vec3 {
  const cosX = Math.cos(rx);
  const sinX = Math.sin(rx);
  const y1 = p.y * cosX - p.z * sinX;
  const z1 = p.y * sinX + p.z * cosX;

  const cosY = Math.cos(ry);
  const sinY = Math.sin(ry);
  const x2 = p.x * cosY + z1 * sinY;
  const z2 = -p.x * sinY + z1 * cosY;

  const cosZ = Math.cos(rz);
  const sinZ = Math.sin(rz);
  return {
    x: x2 * cosZ - y1 * sinZ,
    y: x2 * sinZ + y1 * cosZ,
    z: z2,
  };
}

export function ThreeBackground() {
  const canvasRef = useRef<HTMLCanvasElement | null>(null);
  const { theme } = useTheme();
  const themeRef = useRef(theme);

  useEffect(() => {
    themeRef.current = theme;
  }, [theme]);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const outerIco = createIcosahedron(2.35);
    const innerIco = createIcosahedron(1.32);
    const torusRing = createTorusRing(3.45, 84);

    const particleCount = window.innerWidth < 768 ? 48 : 110;
    const particles: Vec3[] = Array.from({ length: particleCount }, () => ({
      x: (Math.random() - 0.5) * 16,
      y: (Math.random() - 0.5) * 11,
      z: (Math.random() - 0.5) * 8,
    }));

    const mouse = { targetX: 0, targetY: 0, x: 0, y: 0 };
    let targetCameraZ = 11.2;
    let cameraZ = 11.2;

    let icoRotX = 0.25;
    let icoRotY = 0.4;
    let ringRotZ = 0;
    let particleRotY = 0;

    let width = window.innerWidth;
    let height = window.innerHeight;
    let dpr = Math.min(window.devicePixelRatio || 1, 1.75);

    const resize = () => {
      width = window.innerWidth;
      height = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const handleMouseMove = (event: MouseEvent) => {
      mouse.targetX = (event.clientX / window.innerWidth - 0.5) * 0.9;
      mouse.targetY = (event.clientY / window.innerHeight - 0.5) * 0.6;
    };

    const handleScroll = () => {
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, window.scrollY / maxScroll));
      targetCameraZ = 11.2 - progress * 2.1;
    };

    resize();
    handleScroll();

    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', handleMouseMove, { passive: true });
    window.addEventListener('scroll', handleScroll, { passive: true });

    const renderFrame = () => {
      ctx.clearRect(0, 0, width, height);

      const isDark = themeRef.current === 'dark';
      const isMobile = width < 768;
      const originX = isMobile ? width * 0.5 : width * 0.72;
      const originY = height * 0.48;
      const focalLength = Math.min(width, height) * 0.92;

      const glow = ctx.createRadialGradient(
        originX,
        originY,
        15,
        originX,
        originY,
        Math.max(width, height) * 0.45
      );
      glow.addColorStop(0, isDark ? 'rgba(129, 140, 248, 0.14)' : 'rgba(79, 70, 229, 0.08)');
      glow.addColorStop(0.55, isDark ? 'rgba(56, 189, 248, 0.05)' : 'rgba(99, 102, 241, 0.03)');
      glow.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, width, height);

      const project = (p: Vec3, centerX: number, centerY: number) => {
        const depth = Math.max(1.5, cameraZ - p.z);
        const scale = focalLength / depth;
        return {
          x: centerX + p.x * scale,
          y: centerY - p.y * scale,
          z: p.z,
          scale,
        };
      };

      // 1. 3D Particle Constellation
      for (const pt of particles) {
        const rotated = rotatePoint(pt, mouse.y * 0.12, particleRotY + mouse.x * 0.18, 0);
        const p2d = project(rotated, width * 0.5, height * 0.5);
        const depthAlpha = Math.max(0.12, Math.min(0.65, (rotated.z + 5) / 10));
        const r = Math.max(0.8, Math.min(2.4, p2d.scale * 0.02));
        ctx.fillStyle = isDark
          ? `rgba(148, 163, 184, ${(depthAlpha * 0.65).toFixed(3)})`
          : `rgba(100, 116, 139, ${(depthAlpha * 0.48).toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(p2d.x, p2d.y, r, 0, Math.PI * 2);
        ctx.fill();
      }

      // 2. Orbiting 3D Torus Ring
      const projectedRing = torusRing.map((pt) => {
        const spun = rotatePoint(pt, 0, 0, ringRotZ);
        const tilted = rotatePoint(
          spun,
          Math.PI * 0.36 + mouse.y * 0.35,
          Math.PI * 0.18 + mouse.x * 0.45,
          0
        );
        return project(tilted, originX, originY);
      });

      ctx.lineWidth = 1.25;
      for (let i = 0; i < projectedRing.length; i++) {
        const a = projectedRing[i];
        const b = projectedRing[(i + 1) % projectedRing.length];
        const avgZ = (a.z + b.z) * 0.5;
        const alpha = Math.max(0.08, Math.min(0.45, (avgZ + 4) / 8)) * (isDark ? 0.95 : 0.68);
        ctx.strokeStyle = isDark
          ? `rgba(56, 189, 248, ${alpha.toFixed(3)})`
          : `rgba(99, 102, 241, ${alpha.toFixed(3)})`;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }

      // 3. Outer & Inner 3D Wireframe Icosahedrons
      const drawWireframe = (
        geo: { vertices: Vec3[]; edges: [number, number][] },
        rotX: number,
        rotY: number,
        baseAlpha: number,
        lineWidth: number
      ) => {
        const projected = geo.vertices.map((v) => {
          const r = rotatePoint(v, rotX + mouse.y * 0.35, rotY + mouse.x * 0.45, 0);
          return project(r, originX, originY);
        });

        ctx.lineWidth = lineWidth;
        for (const [i, j] of geo.edges) {
          const a = projected[i];
          const b = projected[j];
          const avgZ = (a.z + b.z) * 0.5;
          const depthFactor = Math.max(0.28, Math.min(1, (avgZ + 3) / 6));
          const alpha = baseAlpha * depthFactor;
          ctx.strokeStyle = isDark
            ? `rgba(129, 140, 248, ${alpha.toFixed(3)})`
            : `rgba(79, 70, 229, ${alpha.toFixed(3)})`;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }

        if (lineWidth >= 1) {
          for (const v of projected) {
            const depthFactor = Math.max(0.3, Math.min(1, (v.z + 3) / 6));
            ctx.fillStyle = isDark
              ? `rgba(165, 180, 252, ${(baseAlpha * 1.4 * depthFactor).toFixed(3)})`
              : `rgba(79, 70, 229, ${(baseAlpha * 1.2 * depthFactor).toFixed(3)})`;
            ctx.beginPath();
            ctx.arc(v.x, v.y, 1.8 * depthFactor + 0.6, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      };

      drawWireframe(innerIco, -icoRotX * 1.3, -icoRotY * 1.2, isDark ? 0.18 : 0.11, 0.85);
      drawWireframe(outerIco, icoRotX, icoRotY, isDark ? 0.34 : 0.22, 1.15);
    };

    if (prefersReducedMotion) {
      renderFrame();
      return () => {
        window.removeEventListener('resize', resize);
        window.removeEventListener('mousemove', handleMouseMove);
        window.removeEventListener('scroll', handleScroll);
      };
    }

    let frameId = 0;
    const animate = () => {
      frameId = window.requestAnimationFrame(animate);

      mouse.x += (mouse.targetX - mouse.x) * 0.04;
      mouse.y += (mouse.targetY - mouse.y) * 0.04;
      cameraZ += (targetCameraZ - cameraZ) * 0.05;

      icoRotY += 0.0042;
      icoRotX += 0.0021;
      ringRotZ -= 0.0036;
      particleRotY += 0.0008;

      renderFrame();
    };

    animate();

    return () => {
      window.cancelAnimationFrame(frameId);
      window.removeEventListener('resize', resize);
      window.removeEventListener('mousemove', handleMouseMove);
      window.removeEventListener('scroll', handleScroll);
    };
  }, []);

  const isDark = theme === 'dark';

  return (
    <div
      aria-hidden="true"
      className="pointer-events-none fixed inset-0 z-0 h-full w-full"
      style={{
        backgroundImage: isDark
          ? 'linear-gradient(to right, rgba(148, 163, 184, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(148, 163, 184, 0.08) 1px, transparent 1px)'
          : 'linear-gradient(to right, rgba(15, 23, 42, 0.055) 1px, transparent 1px), linear-gradient(to bottom, rgba(15, 23, 42, 0.055) 1px, transparent 1px)',
        backgroundSize: '28px 28px',
      }}
    >
      <canvas ref={canvasRef} className="h-full w-full" />
    </div>
  );
}